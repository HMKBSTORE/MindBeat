# Copy this file to a new file named ".env" and fill in the real values
# from your Firebase project settings (see README.md "Firebase Setup").
# Never commit the real .env file to GitHub — it's already in .gitignore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
