rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function ownsStudent(studentId) {
      return isSignedIn() && request.auth.uid == studentId;
    }

    // Students can read every profile (needed for the leaderboard),
    // but can only create/edit their OWN profile document.
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if ownsStudent(studentId) &&
                       request.resource.data.keys().hasOnly([
                         'name', 'email', 'avatar', 'points', 'streak',
                         'longestStreak', 'lastPlayedDate', 'badges', 'history',
                         'createdAt'
                       ]) &&
                       request.resource.data.points == 0;
      // `points` is the existing client-managed XP field used by the current
      // quiz and permanent leaderboard. Reward-wallet fields are intentionally
      // excluded and can only be initialized or changed by Admin SDK Functions.
      allow update: if ownsStudent(studentId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'name', 'avatar', 'points', 'streak', 'longestStreak',
                         'lastPlayedDate', 'badges', 'history', 'dailyChallenge',
                         'games', 'streakFreezes'
                       ]);
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if ownsStudent(studentId);
        allow create, update, delete: if false;
      }
    }

    // Any logged-in student can read questions (to play quizzes).
    // Only the configured admin account can add or change quiz questions.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.token.email == "hussainmehdikhan709@gmail.com";
    }

    // Challenges: only the two participants can read/write their challenge.
    match /challenges/{challengeId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.participants;
    }

    // Device ownership, risk records, wallet ledger, claims, sessions,
    // referrals, tournaments, and withdrawals are server-only foundations.
    match /registered_devices/{deviceId} {
      allow read, write: if false;
    }
    match /quiz_reward_attempts/{attemptId} {
      allow read, write: if false;
    }
    match /device_risk_events/{eventId} {
      allow read, write: if false;
    }
    match /reward_security/{uid} {
      allow read, write: if false;
    }
    match /withdrawal_requests/{requestId} {
      allow read, write: if false;
    }
    match /referrals/{referralId} {
      allow read, write: if false;
    }
    match /tournament_periods/{periodId} {
      allow read, write: if false;
    }
    match /game_sessions/{sessionId} {
      allow read, write: if false;
    }
    match /daily_claims/{claimId} {
      allow read, write: if false;
    }
    match /lucky_spins/{spinId} {
      allow read, write: if false;
    }
  }
}
