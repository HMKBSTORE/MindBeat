rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Students can read every profile (needed for the leaderboard),
    // but can only create/edit their OWN profile document.
    match /students/{studentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == studentId;
      allow update: if request.auth != null && request.auth.uid == studentId;
      allow delete: if false;
    }

    // Any logged-in student can read questions (to play quizzes).
    // Only your admin account should be able to add new ones — replace
    // the email below with the SAME one you set as ADMIN_EMAIL in firebase.js.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.token.email == "hussainmehdikhan709@gmail.com";
    }

    // Challenges: only the two participants can read/write their challenge.
    match /challenges/{challengeId} {
      allow read: if request.auth != null &&
                     request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
                       request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null &&
                       request.auth.uid in resource.data.participants;
    }
  }
}
